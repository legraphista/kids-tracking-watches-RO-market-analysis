---
import '../styles/global.css';
import { t, href } from '../lib/i18n.mjs';
const { lang, path, title, description, image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = `${title ? `${title} — ` : ''}${t('siteTitle', lang)}`;
const desc = description || t('tagline', lang);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}${image || '/og.png'}`, Astro.site).href;
const nav = [
  { p: '/', label: t('navHome', lang) },
  { p: '/method/', label: t('navMethod', lang) },
  { p: '/battery/', label: t('navBattery', lang) },
  { p: '/reviews/', label: t('navReviews', lang) },
];
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={path.startsWith('/watches/') ? 'article' : 'website'} />
    <meta property="og:site_name" content={t('siteTitle', lang)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ro' ? 'ro_RO' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ro' ? 'en_US' : 'ro_RO'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // set before first paint to avoid a flash; manual choice persists, else system
      (function () {
        var stored = localStorage.getItem('theme');
        var dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⌚</text></svg>" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={href(base, lang, '/')}>{lang === 'ro' ? 'Ceasuri GPS · cercetare RO' : 'GPS watches · RO research'}</a>
        <nav>
          {nav.map((n) => (
            <a href={href(base, lang, n.p)} aria-current={n.p === path || (n.p === '/' && path.startsWith('/watches/')) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <span class="langswitch">
          <a class={lang === 'en' ? 'on' : ''} href={href(base, 'en', path)} aria-label={t('langName', 'en')} title={t('langName', 'en')}>
            <svg viewBox="0 0 60 30" class="flag"><clipPath id="ukclip"><path d="M0,0 v30 h60 v-30 z"/></clipPath><path d="M0,0 v30 h60 v-30 z" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#ukclip)" stroke="#C8102E" stroke-width="4"/><path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/><path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/></svg> EN
          </a>
          <a class={lang === 'ro' ? 'on' : ''} href={href(base, 'ro', path)} aria-label={t('langName', 'ro')} title={t('langName', 'ro')}>
            <svg viewBox="0 0 60 30" class="flag"><rect width="20" height="30" fill="#002B7F"/><rect x="20" width="20" height="30" fill="#FCD116"/><rect x="40" width="20" height="30" fill="#CE1126"/></svg> RO
          </a>
        </span>
        <button class="themetoggle" id="themetoggle" aria-label={t('themeToggle', lang)} title={t('themeToggle', lang)}>◐</button>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        {t('footer', lang)} <a href="https://github.com/legraphista/kids-tracking-watches-RO-market-analysis">GitHub</a>.
        {t('tagline', lang)}
      </div>
    </footer>
    <script is:inline>
      document.getElementById('themetoggle').addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
