---
import Base from '../layouts/Base.astro';
import SpecTable from './SpecTable.astro';
import { t } from '../lib/i18n.mjs';
import { renderMd } from '../lib/render.mjs';
const { watch, summary, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const name = summary?.name || String(watch.data.model).split('(')[0].trim();
---
<Base lang={lang} path="/" title={name}>
  <h1>{name}</h1>
  {!watch.gated && (
    <p>
      <span class="chip">{t('colCap', lang)}: <span class="score">{watch.capability}</span>/10</span>
      {' '}
      <span class="chip">{t('colEv', lang)}: <span class="score">{watch.evidence}</span>/10</span>
    </p>
  )}
  {watch.gated && (
    <p><strong>{t('gateReason', lang)}:</strong> {watch.gateReason}</p>
  )}
  {summary && (
    <>
      <p class="summary-note">{t('summaryNote', lang)}</p>
      <div class="prose" set:html={renderMd(summary.body, { lang, base })} />
    </>
  )}
  <SpecTable watch={watch} lang={lang} />
  {!watch.gated && watch.matrixNote && (
    <p class="summary-note"><strong>{t('matrixNote', lang)}:</strong> {watch.matrixNote}</p>
  )}
  <details class="evidence">
    <summary>{t('fullEvidence', lang)}</summary>
    <div class="prose" set:html={renderMd(watch.body, { lang, base })} />
  </details>
</Base>
