---
import Base from '../layouts/Base.astro';
import SpecTable from './SpecTable.astro';
import GnssWidget from './GnssWidget.astro';
import BandsWidget from './BandsWidget.astro';
import BatteryWidget from './BatteryWidget.astro';
import { t } from '../lib/i18n.mjs';
import { renderMd } from '../lib/render.mjs';
const { watch, summary, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const name = summary?.name || String(watch.data.model).split('(')[0].trim();

// weave each explainer widget into its matching summary section
const WIDGET_AFTER = lang === 'ro'
  ? { Conectivitate: 'bands', Localizare: 'gnss', Baterie: 'battery' }
  : { Connectivity: 'bands', Positioning: 'gnss', Battery: 'battery' };
function splitSections(md) {
  const parts = md.split(/^## +/m);
  const chunks = [];
  if (parts[0].trim()) chunks.push({ heading: null, md: parts[0] });
  for (let i = 1; i < parts.length; i++) {
    const nl = parts[i].indexOf('\n');
    const heading = (nl === -1 ? parts[i] : parts[i].slice(0, nl)).trim();
    chunks.push({ heading, md: '## ' + parts[i] });
  }
  return chunks;
}
const chunks = summary ? splitSections(summary.body) : [];
const placed = new Set(chunks.map((c) => WIDGET_AFTER[c.heading]).filter(Boolean));
---
<Base lang={lang} path={`/watches/${watch.slug}/`} title={name} description={summary?.verdict_line}>
  <h1>{name}</h1>
  {!watch.gated && (
    <p>
      <span class="chip">{t('colCap', lang)}: <span class="score">{watch.capability}</span>/10</span>
      {' '}
      <span class="chip">{t('colEv', lang)}: <span class="score">{watch.evidence}</span>/10</span>
    </p>
  )}
  {watch.gated && (
    <p><strong>{t('gateReason', lang)}:</strong> {watch.gateReason}</p>
  )}
  {summary && <p class="summary-note">{t('summaryNote', lang)}</p>}
  {chunks.map((c) => (
    <>
      <div class="prose" set:html={renderMd(c.md, { lang, base })} />
      {WIDGET_AFTER[c.heading] === 'bands' && <BandsWidget watch={watch} lang={lang} />}
      {WIDGET_AFTER[c.heading] === 'gnss' && <GnssWidget watch={watch} lang={lang} />}
      {WIDGET_AFTER[c.heading] === 'battery' && <BatteryWidget watch={watch} lang={lang} />}
    </>
  ))}
  {!placed.has('bands') && <BandsWidget watch={watch} lang={lang} />}
  {!placed.has('gnss') && <GnssWidget watch={watch} lang={lang} />}
  {!placed.has('battery') && <BatteryWidget watch={watch} lang={lang} />}
  <SpecTable watch={watch} lang={lang} />
  {!watch.gated && watch.matrixNote && (
    <p class="summary-note"><strong>{t('matrixNote', lang)}:</strong> {watch.matrixNote}</p>
  )}
  <details class="evidence">
    <summary>{t('fullEvidence', lang)}</summary>
    <div class="prose" set:html={renderMd(watch.body, { lang, base })} />
  </details>
</Base>
