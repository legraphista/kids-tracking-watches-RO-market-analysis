---
import { t } from '../lib/i18n.mjs';
import { loadWatches, loadSummaries } from '../lib/watches.mjs';
import { operatorFit, indoorFit, positioningFit, parsePrice } from '../lib/robands.mjs';
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const watches = loadWatches();
const summaries = loadSummaries(lang);
// Angel Watch sits in the matrix but is a do-not-buy (Android app pulled from Play)
const DO_NOT_BUY = new Set(['angel-watch-series-r']);
function roCell(w) {
  if (w.gated) return { label: t('gated', lang), cls: 'bad' };
  const s = String(w.data.ro_status || 'unknown').split(/\s/)[0];
  const map = t('roStatus', lang);
  const cls = s === 'verified' ? 'ok' : s === 'likely' ? 'ok' : s === 'fails' ? 'bad' : 'warn';
  return { label: map[s] || s, cls };
}
function short(v, n = 40) {
  if (v === undefined || v === null) return '—';
  const s = String(v).split('#')[0].trim();
  return s.length > n ? s.slice(0, n - 1) + '…' : s;
}
const OP_MARK = { full: { m: '✓', cls: 'ok' }, outdoor: { m: '~', cls: 'warn' }, unknown: { m: '?', cls: 'warn' }, none: { m: '✗', cls: 'bad' } };
const tiles = watches.map((w) => {
  const sum = summaries[w.slug];
  const ops = operatorFit(w.data.lte_bands);
  const indoor = indoorFit(w.data.lte_bands);
  const posKind = positioningFit(w.data.positioning);
  return {
    slug: w.slug,
    name: sum?.name || String(w.data.model).split('(')[0].trim(),
    price: [w.data.price_display_eur, w.data.price_display_ron].filter(Boolean).join(' · ')
      || parsePrice(w.data.price_eur, w.data.price_ro_eur),
    priceRaw: `${String(w.data.price_eur ?? '')} || ${String(w.data.price_ro_eur ?? '')}`.slice(0, 300),
    verdict: sum?.verdict_line || '',
    ops: [
      ['Orange', OP_MARK[ops.orange]],
      ['Vodafone', OP_MARK[ops.vodafone]],
      ['Digi', OP_MARK[ops.digi]],
    ],
    indoor:
      indoor.level === 'yes'
        ? { m: `✓ ${indoor.bands.join('+')}`, cls: 'ok' }
        : indoor.level === 'no'
          ? { m: `✗ ${t('vNoSub1', lang)}`, cls: 'bad' }
          : { m: `? ${t('unknown', lang)}`, cls: 'warn' },
    pos:
      posKind === 'galileo'
        ? { m: `✓ ${t('vPosGalileo', lang)}`, cls: 'ok' }
        : posKind === 'dualband'
          ? { m: `✓ ${t('vPosDual', lang)}`, cls: 'ok' }
          : posKind === 'nogalileo'
            ? { m: `~ ${t('vPosNoGal', lang)}`, cls: 'warn' }
            : { m: `? ${t('unknown', lang)}`, cls: 'warn' },
    battClaimed: short(w.data.battery_claimed_h, 34),
    battObserved: short(w.data.battery_observed_h, 34),
    cap: w.gated ? null : w.capability,
    ev: w.gated ? null : w.evidence,
    ro: roCell(w),
    gateReason: w.gated ? w.gateReason : null,
    cls: DO_NOT_BUY.has(w.slug) ? 'dnb' : w.gated ? 'gated' : '',
    dnb: DO_NOT_BUY.has(w.slug),
  };
});
---
<h2>{t('tableTitle', lang)}</h2>
<p class="hint">{t('tilesNote', lang)}</p>
<div class="tiles">
  {tiles.map((r) => (
    <article class={`tile ${r.cls}`}>
      <header class="tile-head">
        <h3>
          <a class="watchname" href={`${base}${lang === 'en' ? '/en' : ''}/watches/${r.slug}/`}>{r.name}</a>
          {r.dnb && <span class="chip bad">{t('doNotBuy', lang)}</span>}
          <span class={`chip ${r.ro.cls}`}>{t('tileRo', lang)} {r.ro.label}</span>
        </h3>
        <p class="tile-price" title={r.priceRaw}>
          {r.price} <span class="hint">({t('tilePriceNote', lang)})</span>
        </p>
      </header>
      <p class="tile-verdict">{r.verdict || r.gateReason}</p>
      <dl class="tile-features">
        <div>
          <dt>{t('tileWorksWith', lang)}</dt>
          <dd>{r.ops.map(([name, mk]) => <span class={`chip ${mk.cls}`}>{name} {mk.m}</span>)}</dd>
        </div>
        <div>
          <dt>{t('tileIndoor', lang)}</dt>
          <dd><span class={`chip ${r.indoor.cls}`}>{r.indoor.m}</span></dd>
        </div>
        <div>
          <dt>{t('tilePositioning', lang)}</dt>
          <dd><span class={`chip ${r.pos.cls}`}>{r.pos.m}</span></dd>
        </div>
        <div>
          <dt>{t('colBattery', lang)}</dt>
          <dd>{r.battClaimed} / {r.battObserved}</dd>
        </div>
        <div class="tile-scores">
          <dt>{t('tileScores', lang)}</dt>
          <dd>
            {r.cap !== null ? (
              <>
                <span class="mini">
                  <span class="mini-label">{t('colCap', lang)}</span>
                  <span class="mini-track"><span class="mini-bar cap" style={`width:${r.cap * 10}%`}></span></span>
                  <span class="score">{r.cap}/10</span>
                </span>
                <span class="mini">
                  <span class="mini-label">{t('colEv', lang)}</span>
                  <span class="mini-track"><span class="mini-bar ev" style={`width:${r.ev * 10}%`}></span></span>
                  <span class="score">{r.ev}/10</span>
                </span>
              </>
            ) : (
              <span class="chip bad">{t('gated', lang)}</span>
            )}
          </dd>
        </div>
      </dl>
    </article>
  ))}
</div>
